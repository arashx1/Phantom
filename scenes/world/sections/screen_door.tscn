[sub_resource type="Shader" id="LampShader"]
code = "shader_type spatial;
render_mode unshaded;
varying float phase;
void vertex() { phase = dot(MODEL_MATRIX[3].xyz,vec3(0.73,1.21,0.37)); }
void fragment() {
 float flame = 0.88 + 0.08*sin(2.4*TIME+phase) + 0.04*sin(5.7*TIME+phase);
 ALBEDO = vec3(1.0,0.61,0.21)*flame;
}"

[sub_resource type="ShaderMaterial" id="Lamp"]
shader = SubResource("LampShader")

[sub_resource type="BoxMesh" id="Glass"]
size = Vector3(0.20,0.32,0.18)
material = SubResource("Lamp")

[sub_resource type="Shader" id="SilkShader"]
code = "shader_type spatial;
render_mode cull_disabled;
varying float fold;
void vertex(){
 float phase=dot(MODEL_MATRIX[3].xyz,vec3(0.13,0.35,0.51));
 fold=sin(UV.x*36.0 + phase + TIME*1.7);
 VERTEX.z += UV.y*UV.y*(0.06*fold+0.04*sin(TIME*1.15+phase));
}
void fragment(){
 vec2 panel=vec2(fract(UV.x*3.0),UV.y);
 if (min(panel.x,1.0-panel.x)<0.025 && UV.y>0.08){discard;}
 float diamond=abs(panel.x-0.5)*1.5+abs(panel.y-0.47);
 float ink=max(1.0-smoothstep(0.018,0.04,abs(diamond-0.22)),step(0.91,UV.y));
 ALBEDO=mix(vec3(0.028,0.105,0.095),vec3(0.58,0.39,0.16),ink)*(0.92+0.08*fold);
 ROUGHNESS=0.92;
}"

[sub_resource type="ShaderMaterial" id="Silk"]
